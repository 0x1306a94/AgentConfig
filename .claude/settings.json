{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Write|Edit|Bash|PowerShell|Grep|Glob|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/hooks/deny-read.py\"",
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
