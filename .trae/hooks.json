{
  "version": 1,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Write|Edit|Glob|Grep|LS|RunCommand",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/hooks/deny-read.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
